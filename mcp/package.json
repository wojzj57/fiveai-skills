{
  "name": "fiveai-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "FiveM local debug MCP (FiveAI) - v1 type contracts.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
